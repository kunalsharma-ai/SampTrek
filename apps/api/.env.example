# ─── Server basics: the only settings SampTrek reads from here (docs/INTEGRATIONS.md) ───
# No API key or secret goes in this file. Email (Zoho Mail), single sign-on, Gemini AI, Zoho Books,
# Xero, QuickBooks, Tally, SampAudience, SampBidx, Razorpay, Stripe, push, backup storage and proxycheck.io
# are entered by an admin in the app under Settings → Integrations and stored in the database, encrypted
# with MFA_ENCRYPTION_KEY below. Keys left here by an older version are copied into the database once on
# start and then ignored; the API log lists the lines you can delete.
DATABASE_URL=mongodb://localhost:27017/projexa?replicaSet=rs0
# Database used by the e2e tests (it is reset by the tests)
TEST_DATABASE_URL=mongodb://localhost:27017/projexa_test?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
# Master key: encrypts secrets saved in Settings → Integrations, accounting tokens and two-step sign-in
# secrets (docs/MFA.md). Set it separately from JWT_SECRET and never change it. Falls back to JWT_SECRET when unset.
MFA_ENCRYPTION_KEY=change-me-to-another-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API with cookies (the web app)
WEB_ORIGIN=http://localhost:3000
# Public base URL of this API, used when building respondent entry links
# (Sampledge's own server: https://samptrek.sampledge.com, formerly projexa.sampledge.com; see docs/SAMPTREK_ADDRESS.md)
PUBLIC_BASE_URL=http://localhost:4000
# Disable the background callback worker (tests run it manually)
CALLBACK_WORKER_ENABLED=true
# Public API (docs/PUBLIC_API.md): requests per minute per API key. The same worker flag also sends event webhooks.
PUBLIC_API_RATE_LIMIT=120

# ─── Background jobs (not keys; on by default) ───
# Set a switch to false on all but one API instance when you run several.
REPORT_SCHEDULER_ENABLED=true
# Scheduled activation of redirect versions (docs/REDIRECT_DESTINATIONS.md)
REDIRECT_SCHEDULER_ENABLED=true
# Daily data-retention run (Settings → Privacy)
PRIVACY_SCHEDULER_ENABLED=true
# Super Admin automation rules (docs/SUPER_ADMIN.md), checked hourly
AUTOMATION_SCHEDULER_ENABLED=true
# Emails at 80% and 100% of a plan limit (docs/PLAN_LIMITS.md), checked hourly
LIMIT_ALERTS_ENABLED=true
# Fieldwork monitor (docs/FIELDWORK_MONITOR.md): five-minute pace and alert check
MONITOR_ENABLED=true
# ZOHO_BOOKS_SCHEDULER_ENABLED=true
# LEDGER_SCHEDULER_ENABLED=true
# BACKUP_SCHEDULER_ENABLED=true
# Status page self-checks every minute (docs/STATUS_PAGE.md)
# STATUS_CHECKS_ENABLED=true

# ─── Server options (not keys) ───
# Respondent security (docs/RESPONDENT_SECURITY.md): request header with the respondent country from
# your CDN, e.g. cf-ipcountry. Unset = geolocation inactive.
GEO_COUNTRY_HEADER=
# TOR exit list refresh (set to false for offline installs)
TOR_EXIT_LIST_SYNC=true
# Redirect health link check: allow client survey hosts on private networks (on-premises only). docs/REDIRECT_HEALTH.md
LINK_CHECK_ALLOW_PRIVATE=false
# PDF export: folder holding DejaVuSans.ttf and DejaVuSans-Bold.ttf (default apps/api/assets/fonts).
# PDF_FONT_DIR=
# Backups (docs/BACKUPS.md): the MongoDB Database Tools (mongodump, mongorestore) must be installed;
# MONGO_TOOLS_DIR if they are not on the PATH. Where backups go is chosen in Settings → Integrations.
# MONGO_TOOLS_DIR=/opt/mongodb-database-tools/bin
# Only for Xero apps created before March 2026 that still use broad scopes
# XERO_SCOPES=offline_access accounting.contacts accounting.transactions accounting.settings.read
